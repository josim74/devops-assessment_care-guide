apiVersion: v1
kind: Secret
metadata:
  name: care-guide-secret
  labels:
    app.kubernetes.io/name: care-guide-service
    app.kubernetes.io/part-of: devops-assessment
type: Opaque
# NOTE: Secrets should NEVER be committed in plaintext to version control.
# In production on AWS EKS, use External Secrets Operator (ESO) backed by AWS Secrets Manager,
# or Bitnami Sealed Secrets.
# For local evaluation, copy this template:
#   cp k8s/base/secret.yaml.template k8s/base/secret.yaml
# And replace the placeholder values below with base64 encoded strings:
#   echo -n "your_api_token" | base64
stringData:
  API_SECRET_KEY: "change-me-in-production-super-secret-token"
